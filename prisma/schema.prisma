generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PENDING
  USER
  ADMIN
  SUPER_ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
  PRIVATE_SHARED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(PENDING)
  createdAt    DateTime @default(now()) @map("created_at")

  sessions         Session[]
  favorites        Favorite[]
  resetTokens      PasswordResetToken[]
  createdResources Resource[]      @relation("ResourceCreator")
  resourceShares   ResourceShare[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model ResourceType {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  resources Resource[]

  @@map("types")
}

model Resource {
  id          Int                @id @default(autoincrement())
  title       String
  url         String             @unique
  description String?
  typeId      Int                @map("type_id")
  type        ResourceType       @relation(fields: [typeId], references: [id])
  imgUrl      String?            @map("img_url")
  visibility  Visibility         @default(PUBLIC)
  creatorId   String?            @map("creator_id")
  creator     User?              @relation("ResourceCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  categories  ResourceCategory[]
  favorites   Favorite[]
  shares      ResourceShare[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([typeId])
  @@index([creatorId])
  @@map("resources")
}

model Category {
  id        Int                @id @default(autoincrement())
  name      String
  parentId  Int?               @map("parent_id")
  parent    Category?          @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[]         @relation("CategoryToCategory")
  resources ResourceCategory[]

  @@index([parentId])
  @@map("categories")
}

model ResourceCategory {
  resourceId Int      @map("resource_id")
  categoryId Int      @map("category_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([resourceId, categoryId])
  @@map("resource_categories")
}

model ResourceShare {
  id         Int      @id @default(autoincrement())
  resourceId Int      @map("resource_id")
  userId     String   @map("user_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([resourceId, userId])
  @@map("resource_shares")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId Int      @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@map("favorites")
}